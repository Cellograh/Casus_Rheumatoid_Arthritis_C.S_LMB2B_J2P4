# ============================================================
# BAM-bestanden sorteren en indexeren
# ============================================================
# Doel:
# De gemapte BAM-bestanden worden gesorteerd en geïndexeerd,
# zodat deze bestanden geschikt zijn voor verdere RNA-seq analyse.
#
# Input:
# - BAM-bestanden afkomstig uit het mapping-script
#
# Output:
# - Gesorteerde en geïndexeerde BAM-bestanden
#
# Benodigd package:
# Rsamtools
# ============================================================

library(Rsamtools)
library(Rsubread)

lapply(samples, function(s) {sortBam(file = paste0(s, '.BAM'), destination = paste0(s, '.sorted'))})

lapply(samples, function(s) {indexBam(file = paste0(s, '.sorted.bam'))})
 

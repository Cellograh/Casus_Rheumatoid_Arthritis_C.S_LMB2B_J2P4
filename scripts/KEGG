# ============================================================
# KEGG pathway enrichment analysis
# ============================================================
# Doel:
# Vaststellen welke biologische pathways oververtegenwoordigd
# zijn onder de geselecteerde differentieel geëxprimeerde genen.
#
# Input:
# - DESeq2-resultaten
#
# Selectiecriteria:
# - padj < 0.05
# - |log2FoldChange| > 1
#
# Gene annotation:
# Gen symbols worden geconverteerd naar Entrez Gene IDs
# met behulp van org.Hs.eg.db.
#
# Analyse:
# KEGG enrichment wordt uitgevoerd met clusterProfiler.
#
# Output:
# - KEGG enrichment resultaten
# - Dotplot van de verrijkte pathways
#
# Referentie:
# Wu et al. (2021), clusterProfiler
# ============================================================

BiocManager::install("clusterProfiler")
BiocManager::install("org.Hs.eg.db")
BiocManager::install("enrichplot")

library(clusterProfiler)
library(org.Hs.eg.db)
library(enrichplot)

sig_genes <- rownames(resultaten[
  which(resultaten$padj < 0.05 &
          abs(resultaten$log2FoldChange) > 1),])
length(sig_genes)

gene_df <- bitr(
  sig_genes,
  fromType = "SYMBOL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db)

kegg_results <- enrichKEGG(
  gene = gene_df$ENTREZID,
  organism = "hsa",
  pvalueCutoff = 0.05)
#resultaten bekijken
head(as.data.frame(kegg_results))

dotplot(kegg_results, showCategory = 15) 



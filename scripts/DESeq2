# ============================================================
# Differential expression analysis met DESeq2
# ============================================================
# Doel:
# Identificeren van differentieel geëxprimeerde genen tussen
# de RA-groep en de gezonde controlegroep.
#
# Input:
# - Count matrix
# - Treatmentinformatie per sample
#
# Analyse:
# DESeq2 wordt gebruikt met treatment als experimentele factor.
# Significantiedrempel:
# - adjusted p-value (padj) < 0.05
# - |log2FoldChange| > 1
#
# Output:
# - DESeq2_resultaten.csv
# - PCA-plot
#
# Referentie:
# Love et al. (2014), DESeq2
# ============================================================

library(DESeq2)

dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = treatment_table,
  design = ~ treatment)

dds <- DESeq(dds)
resultaten <- results(dds)

up_genes <- rownames(
  resultaten[
    !is.na(resultaten$padj) &
      !is.na(resultaten$log2FoldChange) &
      resultaten$padj < 0.05 &
      resultaten$log2FoldChange > 1,])

down_genes <- rownames(
  resultaten[
    !is.na(resultaten$padj) &
      !is.na(resultaten$log2FoldChange) &
      resultaten$padj < 0.05 &
      resultaten$log2FoldChange < -1,])

length(up_genes)
length(down_genes)

write.csv(as.data.frame(resultaten),
          "DESeq2_resultaten.csv")

#PCA-plot
vsd <- vst(dds)
plotPCA(vsd, intgroup = "treatment")

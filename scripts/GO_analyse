# ============================================================
# Gene Ontology enrichment analysis
# ============================================================
# Doel:
# Onderzoeken welke biologische processen (Biological Process)
# verrijkt zijn onder de geselecteerde differentieel
# geëxprimeerde genen.
#
# Input:
# - Geselecteerde differentieel geëxprimeerde genen
# - Entrez Gene IDs
#
# Selectiecriteria:
# - padj < 0.05
# - |log2FoldChange| > 1
#
# GO-ontologie:
# - Biological Process (BP)
#
# Multiple testing:
# Benjamini-Hochberg correctie
#
# Output:
# - GO enrichment resultaten
#
# Referentie:
# Wu et al. (2021), clusterProfiler
# ============================================================

sig <- resultaten[which(resultaten$padj < 0.05 & abs(resultaten$log2FoldChange) > 1), ]
genes <- rownames(sig)
library(enrichplot)

go_bp <- enrichGO(
  gene = entrez$ENTREZID,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff = 0.05,
  qvalueCutoff = 0.05,
  readable = TRUE
)
head(as.data.frame(go_bp))

go_df <- as.data.frame(go_bp)

dim(go_df)
head(go_df, 20)
